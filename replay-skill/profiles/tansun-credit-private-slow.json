{
  "platform": "tansun-credit-private",
  "name": "天阳信贷一站式门户（test.creditv5p2）- 对私客户管理",
  "baseUrl": "http://test.creditv5p2.tansun.com.cn",
  "homeRoute": "/#/cstMgt/csinfMnt/prvtCstMgt/idcstMgtPg",
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "login": {
    "username": "701994",
    "password": "1",
    "usernameSelector": "input[name='username']",
    "passwordSelector": "input[name='password']",
    "captchaSelector": "input[placeholder*='图形']",
    "captchaValue": "1234",
    "legalPersonSelector": "input[placeholder*='法人']",
    "loginButtonText": "登录",
    "loggedInUrlShouldNotContain": "/login"
  },
  "pages": [
    {
      "match": [
        "对私客户管理列表",
        "对私客户管理"
      ],
      "urlPattern": "idcstMgtPg",
      "route": "/#/cstMgt/csinfMnt/prvtCstMgt/idcstMgtPg",
      "readySelector": "//button[normalize-space()='查询']"
    },
    {
      "match": [
        "对私客户基本信息"
      ],
      "urlPattern": "fcnScnEcd",
      "readySelector": "//button[normalize-space()='暂存']"
    },
    {
      "match": [
        "客户概况"
      ],
      "urlPattern": "viewType",
      "readySelector": "//button[normalize-space()='返回']"
    }
  ],
  "popups": [
    {
      "match": [
        "新增客户校验",
        "新增客户"
      ],
      "selector": ".el-drawer"
    },
    {
      "match": [
        "法院信息查询"
      ],
      "selector": ".el-dialog"
    },
    {
      "match": [
        "影像资料"
      ],
      "selector": ".el-dialog"
    }
  ],
  "popupFallbackSelector": ".el-dialog, .el-message-box",
  "backButtonText": "返回",
  "tableRowSelector": ".el-table__body-wrapper .el-table__body tbody tr:visible",
  "selectDropdownItemSelector": ".el-select-dropdown__item",
  "errorToastSelector": ".el-message--error, .el-notification--error",
  "tableReadySelector": ".el-table__header",
  "settleAfterClickMs": 6000,
  "settleAfterInputMs": 1000
}