{
  "platform": "tansun-credit",
  "name": "对公客户评级62功能点全新录制",
  "baseUrl": "http://test.creditv5p2.tansun.com.cn",
  "homeRoute": "/#/rtgMgt/cpctRtg/cpctRtgAplyMgtPg",
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "login": {
    "username": "701994",
    "password": "1",
    "usernameSelector": "input[name='username']",
    "passwordSelector": "input[name='password']",
    "loginButtonText": "登录",
    "loggedInUrlShouldNotContain": "/login"
  },
  "pages": [
    {
      "match": [
        "对公评级审批任务"
      ],
      "urlPattern": "FS00005854",
      "readySelector": "//body"
    },
    {
      "match": [
        "对公客户360视图"
      ],
      "urlPattern": "FS00008308",
      "readySelector": "//body"
    },
    {
      "match": [
        "新增对公客户评级",
        "评级详情-"
      ],
      "urlPattern": "FS00005854Host",
      "readySelector": "//button[normalize-space()='返回']"
    },
    {
      "match": [
        "对公客户评级"
      ],
      "urlPattern": "cpctRtgAplyMgtPg",
      "route": "/#/rtgMgt/cpctRtg/cpctRtgAplyMgtPg",
      "readySelector": "//button[normalize-space()='评级申请']"
    }
  ],
  "popups": [
    {
      "selector": ".el-message-box",
      "match": [
        "流程操作确认"
      ]
    },
    {
      "match": [
        "表单必填校验提示"
      ],
      "selector": ".el-notification.form-error-notice"
    },
    {
      "match": [
        "评级审批意见"
      ],
      "selector": ".el-dialog[aria-label=\"审批意见\"]"
    },
    {
      "match": [
        "最终审批结束确认"
      ],
      "selector": ".el-message-box"
    },
    {
      "match": [
        "流程选人候选人"
      ],
      "selector": ".tree-popover"
    },
    {
      "match": [
        "流程选人"
      ],
      "selector": ".el-dialog[aria-label=\"流程选人\"]"
    },
    {
      "match": [
        "上传征信授权书"
      ],
      "selector": ".el-dialog[aria-label*=\"授权\"], .el-drawer[aria-label*=\"授权\"]"
    },
    {
      "match": [
        "授权信息确认",
        "征信报告查询确认"
      ],
      "selector": ".el-message-box"
    },
    {
      "match": [
        "业务校验提示"
      ],
      "selector": ".el-message-box"
    },
    {
      "match": [
        "客户选择"
      ],
      "selector": ".el-dialog[aria-label=\"客户选择\"]"
    },
    {
      "match": [
        "新增征信查询客户"
      ],
      "selector": ".el-dialog[aria-label='新增征信查询客户']"
    },
    {
      "match": [
        "征信客户选择"
      ],
      "selector": ".el-dialog[aria-label='客户选择']"
    },
    {
      "match": [
        "精确下拉选择"
      ],
      "selector": ".el-select-dropdown:visible"
    },
    {
      "match": [
        "申请客户下拉选择"
      ],
      "selector": ".el-select-dropdown:has(.select-table)"
    },
    {
      "match": [
        "对公客户评级申请"
      ],
      "selector": ".el-drawer[aria-label='对公客户评级申请']"
    },
    {
      "match": [
        "评级重评"
      ],
      "selector": ".el-drawer[aria-label='评级重评']"
    },
    {
      "match": [
        "流程轨迹"
      ],
      "selector": ".el-dialog[aria-label='流程轨迹']"
    },
    {
      "match": [
        "删除确认"
      ],
      "selector": ".el-message-box"
    }
  ],
  "popupFallbackSelector": ".el-dialog, .el-drawer, .el-message-box, .el-select-dropdown:has(.select-table)",
  "backButtonText": "返回",
  "tableRowSelector": ".el-table__body-wrapper .el-table__body tbody tr",
  "tableReadySelector": "//button[normalize-space()='评级申请']",
  "selectDropdownItemSelector": ".el-select-dropdown__item",
  "errorToastSelector": ".el-message--error, .el-notification--error, .el-notification.exception-message",
  "settleAfterClickMs": 900,
  "settleAfterInputMs": 350
}
