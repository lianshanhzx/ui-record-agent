# ============================================================
# 凭据 / 登录态 —— 绝不能进仓库
# auth.json 是 Playwright storageState，含登录 Cookie + localStorage token
# opencode.json 含真实模型 apiKey 与内网地址，模板见 opencode.example.json
# ============================================================
auth.json
**/auth.json
opencode.json
.env
.env.*
!.env.example
*.pem
*.key

# ============================================================
# 客户资料 —— 按固定文件夹忽略（见 README「数据策略与目录规则」）
# 只忽略这四个文件夹；资料放到别处会显示为未跟踪，提醒归位。
# 新增资料类别：建文件夹 + 在此加一行 + README 表格补一行。
# ============================================================
materials/requirements/
materials/screenshots/
materials/catalog/
materials/archive/

# ============================================================
# 录制 / 回放生成物 —— 同样按固定文件夹忽略
#   work/<批次>/、partner-wire/<模块>/ 为历史批次目录，P5 迁移 runs/ 后删除
#   runs/<模块>/<批次>/ 为生成物目标目录
# 根层散文件会以未跟踪状态暴露，提交前另有 scripts/check-layout.mjs 拦截
# ============================================================
work/*/
partner-wire/*/
runs/*/
out/*/
replay-out/*/
playwright-report/
blob-report/
test-results/

# ============================================================
# 依赖
# ============================================================
node_modules/
**/node_modules/

# ============================================================
# 系统 / 编辑器垃圾
# ============================================================
.DS_Store
Thumbs.db
~$*
*.log
True
.idea/
.vscode/
