# ============================================================
# 凭据 / 登录态 —— 绝不能进仓库
# auth.json 是 Playwright storageState，含登录 Cookie + localStorage token
# opencode.json 含真实模型 apiKey 与内网地址，模板见 opencode.example.json
# ============================================================
auth.json
**/auth.json
opencode.json
.env
.env.*
!.env.example
*.pem
*.key
work/**/profile/

# ============================================================
# 录制 / 回放生成物（体积大，且含单个 226MB 的 api-audit.json）
# 这些目录可随时用 replay-skill / playwright 重新生成
# ============================================================
work/
partner-wire/
playwright-report/
blob-report/
test-results/

# ============================================================
# 依赖
# ============================================================
node_modules/
**/node_modules/

# ============================================================
# 需求文档 / 客户资料（二进制大文件，不进版本库）
# docx 需求分册、重复打包的 zip、文档截图、docx 解析中间产物
# ============================================================
*.docx
~$*
*.zip
assets/
work_catalog_*.json

# ============================================================
# 系统 / 编辑器垃圾
# ============================================================
.DS_Store
Thumbs.db
*.log
True
.idea/
.vscode/
