# ============================================================
# 凭据 / 登录态 —— 绝不能进仓库
# auth.json 是 Playwright storageState，含登录 Cookie + localStorage token
# opencode.json 含真实模型 apiKey 与内网地址，模板见 opencode.example.json
# ============================================================
auth.json
**/auth.json
opencode.json
.env
.env.*
!.env.example
*.pem
*.key
work/**/profile/

# ============================================================
# 录制 / 回放生成物（体积大，且含单个 226MB 的 api-audit.json）
# 按「目录结构」忽略，不用一刀切的整目录规则：
#   work/<批次>/、partner-wire/<模块>/、runs/<模块>/、out/<批次>/
# 结构外的散文件会以未跟踪状态暴露出来，提醒归位；
# 提交前另有 scripts/check-layout.mjs 兜底拦截。
# work/*.* 与 partner-wire/*.json 只覆盖历史批次遗留在根层的散文件，
# P5 迁移到 runs/ 时一并清理，之后这两条应删除。
# ============================================================
work/*/
work/*.*
partner-wire/*/
partner-wire/*.json
runs/*/
out/*/
replay-out/*/
playwright-report/
blob-report/
test-results/

# ============================================================
# 依赖
# ============================================================
node_modules/
**/node_modules/

# ============================================================
# 客户资料（二进制大文件，不进版本库）
# 按「约定结构」逐项忽略，不做 materials/ 整目录忽略：
#   放进规定子目录的自动忽略；放到别处会显示为未跟踪，提醒归位，
#   避免有人随手丢文件后整个目录被静默吞掉。
# 结构说明见 docs/materials.md，校验见 scripts/check-layout.mjs
# ============================================================
materials/requirements/*.docx
materials/screenshots/*.png
materials/screenshots/*.jpg
materials/screenshots/*.jpeg
materials/screenshots/*.gif
materials/catalog/*.json
materials/archive/*.zip
materials/archive/*.rar
materials/archive/*.7z
materials/archive/*.pdf
~$*

# ============================================================
# 系统 / 编辑器垃圾
# ============================================================
.DS_Store
Thumbs.db
*.log
True
.idea/
.vscode/
